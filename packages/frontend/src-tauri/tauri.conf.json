{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Midsphere",
  "version": "0.1.0",
  "identifier": "com.midsphere.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "VITE_TAURI=true VITE_API_BASE_URL=http://localhost:8000 npm run dev",
    "beforeBuildCommand": "VITE_TAURI=true VITE_API_BASE_URL=http://localhost:8000 npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Midsphere",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://*.midsphere.com http://localhost:* https://accounts.google.com https://*.sentry.io https://*.posthog.com; img-src 'self' data: blob: https:; font-src 'self' data:; frame-src https://accounts.google.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["midsphere"]
      },
      "mobile": [
        {
          "host": "app.midsphere.com",
          "pathPrefix": ["/auth/callback"]
        }
      ]
    }
  }
}
