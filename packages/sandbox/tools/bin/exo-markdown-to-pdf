#!/usr/bin/env python3
"""Convert a Markdown file to PDF via python-markdown + headless Chromium.

Usage:
    exo-markdown-to-pdf INPUT [OUTPUT]

If OUTPUT is omitted, the PDF is written next to INPUT with a .pdf extension.
"""
from __future__ import annotations

import sys
from pathlib import Path

ALLOWED_SUFFIXES = {".md", ".markdown", ".mdown", ".mkd"}

_CSS = """
@page { size: A4; margin: 18mm 16mm; }
html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
body {
  font-family: -apple-system, "Segoe UI", system-ui, sans-serif;
  font-size: 11pt; line-height: 1.55; color: #1f2328; max-width: 100%;
}
h1, h2, h3, h4 { color: #0b0f19; margin-top: 1.4em; line-height: 1.25; }
h1 { font-size: 1.9em; border-bottom: 1px solid #d0d7de; padding-bottom: .25em; }
h2 { font-size: 1.5em; border-bottom: 1px solid #eaecef; padding-bottom: .2em; }
h3 { font-size: 1.2em; }
p, ul, ol, blockquote, pre, table { margin: .7em 0; }
a { color: #0969da; text-decoration: none; }
code { font-family: "SF Mono", ui-monospace, Menlo, monospace; font-size: .92em;
       background: #f6f8fa; padding: .15em .35em; border-radius: 4px; }
pre { background: #f6f8fa; padding: 12px 14px; border-radius: 6px; overflow: auto; }
pre code { background: none; padding: 0; }
blockquote { border-left: 3px solid #d0d7de; color: #59636e; padding: .2em .9em; }
table { border-collapse: collapse; width: 100%; }
th, td { border: 1px solid #d0d7de; padding: 6px 10px; text-align: left; }
th { background: #f6f8fa; }
img { max-width: 100%; }
hr { border: none; border-top: 1px solid #d0d7de; margin: 1.5em 0; }
"""


def fail(msg: str, code: int = 1) -> None:
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)


def render_html(md_text: str, title: str) -> str:
    try:
        import markdown
    except ImportError:
        fail("python `markdown` package not installed (pip install markdown)")

    body = markdown.markdown(
        md_text,
        extensions=["extra", "sane_lists", "tables", "fenced_code", "toc"],
        output_format="html5",
    )
    return (
        "<!doctype html><html><head><meta charset='utf-8'>"
        f"<title>{title}</title><style>{_CSS}</style></head>"
        f"<body>{body}</body></html>"
    )


def html_to_pdf(html: str, dst: Path, base_url: str) -> None:
    try:
        from playwright.sync_api import sync_playwright
    except ImportError:
        fail("playwright not installed (pip install playwright && playwright install chromium)")

    with sync_playwright() as p:
        browser = p.chromium.launch()
        try:
            page = browser.new_page()
            page.goto(base_url)
            page.set_content(html, wait_until="networkidle")
            page.pdf(
                path=str(dst),
                format="A4",
                print_background=True,
                margin={"top": "18mm", "bottom": "18mm", "left": "16mm", "right": "16mm"},
            )
        finally:
            browser.close()


def main() -> None:
    args = sys.argv[1:]
    if not args or args[0] in {"-h", "--help"}:
        print(__doc__)
        sys.exit(0 if args else 2)

    src = Path(args[0]).expanduser().resolve()
    if not src.is_file():
        fail(f"input not found: {src}")
    if src.suffix.lower() not in ALLOWED_SUFFIXES:
        fail(f"expected a markdown file, got {src.suffix}")

    dst = Path(args[1]).expanduser().resolve() if len(args) > 1 else src.with_suffix(".pdf")
    dst.parent.mkdir(parents=True, exist_ok=True)

    md_text = src.read_text(encoding="utf-8")
    html = render_html(md_text, title=src.stem)
    html_to_pdf(html, dst, base_url=src.parent.as_uri() + "/")

    print(str(dst))


if __name__ == "__main__":
    main()
