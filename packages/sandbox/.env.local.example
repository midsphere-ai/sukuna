# Local Mode Configuration for Agent Server
# Copy to .env.local and customize.
# Start with: LOCAL_MODE=1 uv run python -m agent_server

LOCAL_MODE=1

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Ollama (default local LLM)
MANAGED_SUPER_LLM_PROVIDER=ollama
MANAGED_SUPER_LLM_MODEL=qwen3:32b
MANAGED_SUPER_LLM_BASE_URL=http://localhost:11434/v1
MANAGED_SUPER_LLM_API_KEY=ollama

# vLLM alternative:
# MANAGED_SUPER_LLM_PROVIDER=openai
# MANAGED_SUPER_LLM_MODEL=meta-llama/Llama-3-70b
# MANAGED_SUPER_LLM_BASE_URL=http://localhost:8001/v1
# MANAGED_SUPER_LLM_API_KEY=dummy

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
AGENT_RUN_TIMEOUT=600

# ── PTC (Programmatic Tool Calling) ──────────────────────────────────────────
# Set to false to disable PTC and expose tools as direct LLM tool calls.
# AGENT_PTC_ENABLED=true

# ── Knowledge Manager (KM) ────────────────────────────────────────────────────
# Set to false to disable the KM loop, KM hooks, and KM invocations entirely.
# AGENT_KM_ENABLED=true

# ── Direct Stream JWT (must match backend SUKUNA_STREAM_JWT_SECRET) ───────────
SUKUNA_STREAM_JWT_SECRET=local-dev-stream-secret

# ── Database (omit for SQLite in-memory) ──────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/sukuna
