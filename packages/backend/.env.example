# ===============================================================================
# Minimal Bootstrap Environment Variables
# ===============================================================================
# These are the ONLY environment variables needed locally.
# All other configuration is loaded from HashiCorp Vault/OpenBao.
#
# The application uses config/openbao.py to:
# 1. Read VAULT_ADDR and VAULT_TOKEN from this .env file
# 2. Connect to Vault and load all secrets into environment variables
#
# To add/modify configuration:
# 1. Store secrets in Vault at cubbyhole/root path
# 2. The load_env_from_vault() function will automatically load them
# ===============================================================================

# HashiCorp Vault/OpenBao server address
VAULT_ADDR=https://vault.example.com:8200

# Vault authentication token (get this from your Vault admin)
VAULT_TOKEN=

# Fernet key for PII encryption (email, name, nickname).
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Must match the key used when the 0006_user_pii_encryption migration ran.
PII_ENCRYPTION_KEY=